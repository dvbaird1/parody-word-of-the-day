{
  "name": "parody-word-of-the-day",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "XDG_CONFIG_HOME=$PWD/.wrangler/config vite --host 127.0.0.1",
    "db:migrate": "XDG_CONFIG_HOME=$PWD/.wrangler/config wrangler d1 migrations apply DB --local",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "XDG_CONFIG_HOME=$PWD/.wrangler/config vite build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261117.0-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.164.0"
  }
}
