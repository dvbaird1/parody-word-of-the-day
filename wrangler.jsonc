{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "parody-word-of-the-day",
  "main": "worker/index.ts",
  "compatibility_date": "2026-04-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "parody-word-of-the-day",
    "database_id": "84c3b3e5-d575-44b3-84c4-aacfcf2e3b3e"
  }]
}
